    "@radix-ui/react-slot": "1.4.0",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "ics": "3.12.1",
    "lucide-react": "1.53.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
